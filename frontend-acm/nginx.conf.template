# ACM frontend — nginx config template (runs inside acm-frontend container).
# - Serves the Vite SPA bundle from /usr/share/nginx/html.
# - History API fallback: any unknown path → index.html (React Router).
# - /api/* → upstream backend, host:port set via $ACM_BACKEND_UPSTREAM.
#
# nginx:1.27-alpine auto-runs envsubst over /etc/nginx/templates/*.template at
# container start. Variables to substitute are listed in NGINX_ENVSUBST_FILTER.
# Examples:
#   - laptop dev (host backend):     ACM_BACKEND_UPSTREAM=backend:4009  (with extra_hosts: backend:host-gateway)
#   - staging compose (containerized backend): ACM_BACKEND_UPSTREAM=backend:4000
# Default falls back to backend:4000 if unset (matches staging).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;

    # Tighten defaults
    server_tokens off;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # FIX-260512: allow file uploads up to 20MB (teacher attachments are
    # capped at 10MB by the backend; leave headroom for multipart overhead).
    # nginx default of 1MB caused 413 on resume PDFs >1MB.
    client_max_body_size 20M;

    # Static assets — long cache, immutable hash filenames from Vite.
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|gif|svg|ico|webp|avif)$ {
        root /usr/share/nginx/html;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    # Backend API — forwarded to NestJS. The Docker network alias `backend`
    # resolves inside docker-compose; for laptop dev where the backend runs
    # native on the host, override at compose time:
    #   extra_hosts: ["backend:host-gateway"]
    location /api/ {
        proxy_pass http://${ACM_BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }

    # SPA fallback — every other route renders index.html so React Router
    # can take over. HTML documents (the SPA shell + static pages under
    # /web/*.html) must NOT be heuristically cached: without an explicit
    # Cache-Control, a browser that fetched this URL *before* the file
    # existed cached the index.html fallback and then React Router bounces
    # it to "/". `no-cache` forces revalidation (ETag/304) on every load.
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
}
