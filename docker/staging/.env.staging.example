# app-academy — Staging environment variables
# Copy to .env.staging on the staging server (NEVER commit .env.staging).
# Generate secrets with:  openssl rand -base64 24

# --- MySQL ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=REPLACE_ME_ROOT
MYSQL_DATABASE=db_tac
MYSQL_USER=tac
MYSQL_PASSWORD=REPLACE_ME_USER

# --- Backend (NestJS) ----------------------------------------------------
JWT_SECRET=REPLACE_ME_JWT_SECRET

# --- Frontend (Next.js + NextAuth) --------------------------------------
NEXTAUTH_SECRET=REPLACE_ME_NEXTAUTH_SECRET
# Canonical public URL (legacy tpi.amoeba.site 301-redirects to this).
NEXTAUTH_URL=https://app-academy-stg.amoeba.site
NEXT_PUBLIC_SITE_URL=https://app-academy-stg.amoeba.site
FRONTEND_URL=https://app-academy-stg.amoeba.site

# --- AMA App Store integration -----------------------------------------
# Subscription webhook HMAC shared secret (issued by AMA).
AMA_WEBHOOK_SECRET=REPLACE_ME_WEBHOOK_SECRET
# Days a CANCELED tenant is preserved before auto-DEPROVISION (default 90).
AMA_DEPROVISION_GRACE_DAYS=90
NEXT_PUBLIC_AMA_APPSTORE_URL=https://amoeba.site/apps/app-academy

# --- AMA Custom App SSO (HS256 JWT exchange) ---------------------------
# Shared secret with AMA platform. Min 16 bytes. Issued by AMA team.
# When unset, /api/acm/auth/ama-exchange returns 503 (legacy login still works).
AMA_JWT_SECRET=
# Comma-separated whitelist of accepted appCode claims.
AMA_JWT_ALLOWED_APP_CODES=tpi-acm

# --- Host paths ----------------------------------------------------------
# Where mysql/redis on-disk data lives on the staging host.
# Default resolves relative to docker/staging/ (i.e. docker/staging/data).
DATA_DIR=/home/appacademy/app-academy/data
