# app-academy — Staging environment variables
# Copy to .env.staging on the staging server (NEVER commit .env.staging).
# Generate secrets with:  openssl rand -base64 24

# --- Backend (NestJS) ----------------------------------------------------
JWT_SECRET=REPLACE_ME_JWT_SECRET

# --- Public URLs ---------------------------------------------------------
# Staging canonical host is ACM SPA only.
FRONTEND_URL=https://acm-stg.amoeba.site
BACKEND_URL=https://acm-stg.amoeba.site

# --- AMA App Store integration -----------------------------------------
# Subscription webhook HMAC shared secret (issued by AMA).
AMA_WEBHOOK_SECRET=REPLACE_ME_WEBHOOK_SECRET
# Days a CANCELED tenant is preserved before auto-DEPROVISION (default 90).
AMA_DEPROVISION_GRACE_DAYS=90
NEXT_PUBLIC_AMA_APPSTORE_URL=https://amoeba.site/apps/app-academy

# --- AMA SSO verification mode (REQ-260609C/D / MANUAL-260609) ---------
# 'local_config' = Custom App token (scope=custom_app:context) verified LOCALLY
#   via the secret+appCode in /admin/config (amb_acm_ama_config). TAC uses this.
# 'ama_session'  = PartnerApp (pap_) OAuth gateway exchange — NOT for Custom App
#   tokens (they return invalid_ama_token). 'local' = legacy HS256 (deprecated).
AMA_TOKEN_VERIFY_MODE=local_config
# 'http' = real AMA calls, 'mock' = fake fixtures. Also drives the AMA platform
# directory client (tch/stf member picker), so it MUST be 'http' even under
# local_config or the picker returns no results.
AMA_SERVICES_MODE=http
# AMA platform directory API (REQ-260604 / FIX-260619) — tch/stf member picker.
# Service token issued by the AMA team. Required when AMA_SERVICES_MODE=http.
AMA_PLATFORM_BASE_URL=https://ama.amoeba.site
AMA_PLATFORM_SERVICE_TOKEN=
AMA_PLATFORM_TIMEOUT_MS=3000
# PartnerApp OAuth creds — 'ama_session' mode ONLY. Leave unset for local_config.
AMA_GATEWAY_URL=https://api.amoeba.site
AMA_CLIENT_ID=
AMA_CLIENT_SECRET=
AMA_OAUTH_TIMEOUT_MS=5000
# AMA 알림 전달 (REQ-261006): 게이트웨이 경로 + AMA PartnerApp 코드(pap_code)
AMA_OPEN_NOTIFICATIONS_PATH=/ama/v1/notifications
AMA_OPEN_NOTIFICATIONS_APP_CODE=tpi-acm

# --- AMA Custom App SSO secret -----------------------------------------
# local_config keeps the Custom App signing secret in /admin/config (DB, AES-GCM),
# NOT here. AMA_JWT_SECRET is for the deprecated 'local' mode only.
AMA_JWT_SECRET=
AMA_JWT_ALLOWED_APP_CODES=tpi-acm

# --- Host paths ----------------------------------------------------------
# Where postgres/redis/minio on-disk data lives on the staging host.
# Default resolves relative to docker/staging/ (i.e. docker/staging/data).
DATA_DIR=/home/appacademy/app-academy/data

# Web Push: generate once with web-push; keep the private key in the environment secret store.
# All three values are required. Empty values keep device push disabled.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# REQ-261016 — 회사 Google Workspace 드라이브 연동. 비우면 연결 버튼 비활성.
ACM_GOOGLE_CLIENT_ID=
ACM_GOOGLE_CLIENT_SECRET=
ACM_GOOGLE_REDIRECT_URI=https://acm-stg.amoeba.site/api/acm/prj/drive/callback
ACM_GOOGLE_PICKER_KEY=
ACM_GOOGLE_PROJECT_NUMBER=
