# app-academy — Production environment variables
# Copy to .env.production on the production server (NEVER commit .env.production).
# Generate secrets with:  openssl rand -base64 24

# --- MySQL ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=REPLACE_ME_ROOT
MYSQL_DATABASE=db_tac
MYSQL_USER=tac
MYSQL_PASSWORD=REPLACE_ME_USER

# --- Backend (NestJS) ----------------------------------------------------
JWT_SECRET=REPLACE_ME_JWT_SECRET

# --- Frontend (Next.js + NextAuth) --------------------------------------
NEXTAUTH_SECRET=REPLACE_ME_NEXTAUTH_SECRET
NEXTAUTH_URL=https://app-academy.amoeba.site
NEXT_PUBLIC_SITE_URL=https://app-academy.amoeba.site
FRONTEND_URL=https://app-academy.amoeba.site
BACKEND_URL=https://app-academy.amoeba.site

# --- AMA App Store integration -----------------------------------------
# Production must use http (live OIDC) — never `mock`.
AMA_OIDC_MODE=http
AMA_OIDC_ISSUER=https://amoeba.site/oidc
AMA_OIDC_CLIENT_ID=REPLACE_ME
AMA_OIDC_CLIENT_SECRET=REPLACE_ME
AMA_OIDC_REDIRECT_URI=https://app-academy.amoeba.site/api/auth/ama/callback
AMA_WEBHOOK_SECRET=REPLACE_ME_WEBHOOK_SECRET
AMA_DEPROVISION_GRACE_DAYS=90
NEXT_PUBLIC_AMA_APPSTORE_URL=https://amoeba.site/apps/app-academy

# --- Host paths ----------------------------------------------------------
DATA_DIR=/var/lib/app-academy
