# app-academy — Production environment variables (template)
# Copy to .env.production on the production server (NEVER commit the live copy).
# Tightened after first-deploy lessons on acm.amoeba.site (RPT-260525):
# missing ACM_PII_KEY / ACM_JWT_SECRET / ACM_PG_PASSWORD caused backend
# crash-loop on first start, and stale URLs pointed at app-academy.amoeba.site.

# --- ACM Postgres -------------------------------------------------------
# Generate: openssl rand -base64 24
ACM_PG_USER=acm
ACM_PG_DATABASE=db_acm
ACM_PG_PASSWORD=REPLACE_ME_ACM_PG

# --- Backend (NestJS core) ---------------------------------------------
# Generate JWT_SECRET: openssl rand -base64 48
JWT_SECRET=REPLACE_ME_JWT_SECRET

# --- ACM (PII encryption + JWT) ----------------------------------------
# ACM_PII_KEY MUST be 32-byte hex (exactly 64 chars).
# Generate: openssl rand -hex 32
ACM_PII_KEY=REPLACE_ME_64_HEX_CHARS
# Generate: openssl rand -base64 48
ACM_JWT_SECRET=REPLACE_ME_ACM_JWT_SECRET
ACM_JWT_EXPIRES_IN=12h

# --- Canonical URLs (canonical = acm.amoeba.site for production) -------
NEXTAUTH_SECRET=REPLACE_ME_NEXTAUTH_SECRET
NEXTAUTH_URL=https://acm.amoeba.site
NEXT_PUBLIC_SITE_URL=https://acm.amoeba.site
FRONTEND_URL=https://acm.amoeba.site
BACKEND_URL=https://acm.amoeba.site

# --- AMA App Store integration (subscription webhook) ------------------
# Subscription webhook HMAC shared secret (issued by AMA team).
AMA_WEBHOOK_SECRET=REPLACE_ME_WEBHOOK_SECRET
AMA_DEPROVISION_GRACE_DAYS=90
NEXT_PUBLIC_AMA_APPSTORE_URL=https://amoeba.site/apps/app-academy

# --- AMA SSO verification mode (REQ-260609C/D / MANUAL-260609) ---------
# How ACM verifies the ?ama_token on POST /api/acm/auth/ama-exchange:
# 'local_config' = TAC PRODUCTION. ACM verifies the AMA **Custom App** token
#                  (scope=custom_app:context, HS256) LOCALLY using the secret +
#                  appCode registered per-tenant at /admin/config
#                  (amb_acm_ama_config). No OAuth gateway / client creds needed.
# 'ama_session'  = PartnerApp OAuth (pap_): delegate to the AMA gateway
#                  (token exchange + introspect). ONLY for PartnerApp tokens —
#                  a Custom App token returns `invalid_ama_token` here.
# 'local'        = legacy self-verify via AMA_JWT_SECRET (deprecated).
AMA_TOKEN_VERIFY_MODE=local_config
# 'http' = real AMA calls, 'mock' = no network (fake fixtures). This drives the
# AMA platform directory client too (the /admin/tch + /admin/stf member picker),
# so it MUST be 'http' even under local_config or the picker returns no results.
AMA_SERVICES_MODE=http

# --- AMA platform directory API (REQ-260604 / FIX-260619) -------------
# Powers the tch/stf AMA member picker (GET /api/v1/entities/{id}/users).
# Service token issued by the AMA team. Required when AMA_SERVICES_MODE=http.
AMA_PLATFORM_BASE_URL=https://ama.amoeba.site
AMA_PLATFORM_SERVICE_TOKEN=REPLACE_ME_AMA_PLATFORM_SERVICE_TOKEN
AMA_PLATFORM_TIMEOUT_MS=3000

# --- PartnerApp OAuth creds — 'ama_session' mode ONLY ------------------
# Issued by AMA operator (MANUAL §2.1). Leave unset for local_config.
AMA_GATEWAY_URL=https://api.amoeba.site
AMA_CLIENT_ID=REPLACE_ME_AMA_CLIENT_ID
AMA_CLIENT_SECRET=REPLACE_ME_AMA_CLIENT_SECRET
AMA_OAUTH_TIMEOUT_MS=5000

# --- AMA Custom App SSO secret -----------------------------------------
# local_config stores the per-tenant Custom App signing secret in /admin/config
# (DB, AES-GCM) — NOT here. AMA_JWT_SECRET below is for the deprecated 'local'
# mode only; unused by local_config / ama_session.
AMA_JWT_SECRET=REPLACE_ME_AMA_JWT_SECRET
# (deprecated, 'local' only) appCode claim whitelist. Unused in local_config/ama_session.
AMA_JWT_ALLOWED_APP_CODES=tpi-acm

# --- BODA(보다에듀) integration (REQ-260526) -----------------------------
# 'mock' (default) until vendor (㈜새하컴즈) cuts over the real SERVER API.
# Generate BODA_CRYPTO_KEY: openssl rand -hex 32  (MUST be 32-byte hex).
BODA_MODE=mock
# Webhook 발신 IP 판정: backend 앞 신뢰 프록시 수 (host nginx → 컨테이너 nginx = 2).
# IP allowlist 가 유일한 웹훅 인증이므로(벤더 시크릿 미제공) 정확해야 한다. (REQ-260920C)
BODA_WEBHOOK_TRUSTED_PROXY_HOPS=2
# 녹화 파일 전체 전송 상한(ms) — 기본 30분. (REQ-260920C)
BODA_DOWNLOAD_TIMEOUT_MS=1800000
# 녹화 따라잡기 범위(h) — 기본 48. 실연동 전환 직후 과거 수업 수집 시 720 등으로 일시 확대. (REQ-260920C)
BODA_RECORDING_SYNC_LOOKBACK_HOURS=48
BODA_CRYPTO_KEY=REPLACE_ME_64_HEX_CHARS
BODA_DEFAULT_ROOM_CODE=
# DEMO MODE — gates POST /admin/cal/.../boda/simulate-event + demo-seed
# endpoints. Keep FALSE in production. (REQ-260610)
BODA_SIMULATE_ENABLED=false

# --- Host paths --------------------------------------------------------
# Default lives under the appacademy home dir so the deploy user owns it.
DATA_DIR=/home/appacademy/app-academy/data

# --- Deploy script sudo fallback (X2 mode — until NOPASSWD sudoers) ----
# Used by scripts/deploy-production.sh sudow() wrapper for nginx reload
# and ACM upload chown. Remove when /etc/sudoers.d/appacademy-deploy is
# in place.
SUDO_PASS=REPLACE_ME_SHELL_LOGIN_PASSWORD
