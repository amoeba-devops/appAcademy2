# Environment Variables — Trinity Academy
# Copy to .env.local for local development

# Database
DATABASE_URL="mysql://root:password@localhost:3306/db_tac"

# Redis
REDIS_URL="redis://localhost:6379"

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Toss Payments
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""
TOSS_WEBHOOK_SECRET=""

# AMA Integration
AMA_API_BASE_URL=""
AMA_WEBHOOK_SECRET=""

# S3 Storage
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""

# reCAPTCHA
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
