# Trinity Academy Backend — Environment Variables
# Copy to .env and fill in values

# Database (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=db_tac

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Toss Payments
# TOSS_SECRET_KEY=
# TOSS_CLIENT_KEY=

# AMA (AI Assessment)
# AMA_API_KEY=
# AMA_API_URL=

# RabbitMQ
# RABBITMQ_URL=amqp://localhost:5672

# AWS S3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
