lerna-debug.log*

# ── OS / IDE ──────────────────────────────────────────────
.DS_Store
*.pem
.vscode/
.idea/

# ── Vercel ────────────────────────────────────────────────
.vercel

# ── Claude / local tooling ────────────────────────────────
.claude/

