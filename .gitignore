.next/
out/
dist/
build/

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing ───────────────────────────────────────────────
coverage/

# ── Environment variables (keep .env.example) ─────────────
.env
.env.*
!.env.example
